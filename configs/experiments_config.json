{
  "project": "NDA Multi-Label Clause Classification",
  "module": "Module 6C — Experiment Matrix & Automated Reporting Infrastructure",
  "version": "1.2.0",
  "dataset_version": "v3_pseudolabels_203valid",
  "split_status": "TEMPORARY / PIPELINE DEBUGGING ONLY — Final benchmark split will be regenerated after additional pseudo-labeling.",
  "target_categories": 14,
  "disclaimer": "Training labels are LLM-generated pseudo-labels and have not yet been fully human-verified.",
  "default_hyperparameters": {
    "seed": 42,
    "max_sequence_length": 256,
    "batch_size": 8,
    "learning_rate": 2e-5,
    "weight_decay": 0.01,
    "epochs": 5,
    "warmup_ratio": 0.1,
    "threshold": 0.5
  },
  "primary_metric": "macro_f1",
  "secondary_metrics": [
    "micro_f1",
    "weighted_f1",
    "hamming_loss",
    "macro_mcc"
  ],
  "candidate_models": [
    {
      "model_id": "saibo/legal-roberta-base",
      "name": "Legal-RoBERTa Baseline",
      "architecture": "RobertaForSequenceClassification"
    },
    {
      "model_id": "nlpaueb/legal-bert-base-uncased",
      "name": "Legal-BERT Alternative",
      "architecture": "BertForSequenceClassification"
    },
    {
      "model_id": "microsoft/deberta-v3-base",
      "name": "DeBERTa-v3 Alternative",
      "architecture": "DebertaV2ForSequenceClassification"
    }
  ],
  "loss_functions": [
    {
      "loss_id": "bce",
      "name": "BCEWithLogitsLoss",
      "description": "Standard Multi-Label Binary Cross-Entropy"
    },
    {
      "loss_id": "focal",
      "name": "Multi-Label Focal Loss",
      "parameters": {"gamma": 2.0, "alpha": 0.25},
      "description": "Focal Loss addressing hard/minority category imbalance"
    },
    {
      "loss_id": "class_weighted_bce",
      "name": "Class-Weighted BCE",
      "description": "BCE with positive weights computed EXCLUSIVELY from the training dataset split"
    }
  ],
